# Copy to apps/web/.env.local for local development.

# Postgres. Local: docker compose up -d. Production: Neon or Supabase, Sydney (ap-southeast-2).
DATABASE_URL=postgres://yieldr:yieldr@localhost:5432/yieldr

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Microsoft Entra admin centre > App registrations).
# Supported account types: any organisational directory and personal Microsoft accounts.
# Redirect URI (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Email (magic links, invites). Without RESEND_API_KEY, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Yieldr <hello@mail.yieldr.property>"
# console | file | resend. "file" writes to .data/outbox.jsonl (used by the end-to-end tests).
EMAIL_TRANSPORT=console

# Comma-separated emails that become super-admins when they first sign in.
YIELDR_ADMIN_EMAILS=
